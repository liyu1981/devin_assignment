{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "tsx src/worker.ts",
    "mock-devin": "tsx src/mock-devin-server.ts",
    "mock-github": "tsx src/mock-github-server.ts",
    "dev:all": "concurrently -n gh-mock,devin-mock,server,w1,w2 \"tsx src/mock-github-server.ts\" \"tsx src/mock-devin-server.ts\" \"next dev\" \"tsx src/worker.ts\" \"tsx src/worker.ts\"",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "next": "16.2.7",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}

# GitHub App webhook secret (used to verify incoming webhook signatures)
# Must be set for mock-github-server to sign payloads correctly
GITHUB_WEBHOOK_SECRET=

# Devin API key (https://app.devin.ai/settings/api)
# Not required when DEVIN_MOCK=true
DEVIN_API_KEY=

# Devin organization ID (required for all Devin API calls)
# Read more: https://docs.devin.ai/v3/api-reference/sessions/create-session
DEVIN_ORG_ID=

# Mock Servers
# Set to "true" to enable the Devin mock server (requires DEVIN_MOCK_PORT to be running)
DEVIN_MOCK=false
# Set to "true" to enable the GitHub mock server (requires GITHUB_MOCK_PORT to be running)
# Also shows the webhook trigger UI on the dashboard
GITHUB_MOCK=false
# Mock Devin server
DEVIN_MOCK_PORT=4000
DEVIN_MOCK_DELAY_MS=60000
DEVIN_MOCK_FAIL=false
# Mock GitHub server
GITHUB_MOCK_PORT=4001
# Where the mock forwards signed webhook events (default: http://localhost:3000/api/github/webhook)
GITHUB_WEBHOOK_URL=

# Worker poll interval in milliseconds (default: 5000)
# Controls how often the background worker checks for pending issues and polls Devin session status
POLL_INTERVAL_MS=5000

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
